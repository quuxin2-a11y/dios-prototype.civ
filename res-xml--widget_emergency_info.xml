<?xml version="1.0" encoding="utf-8"?>
<!-- Size and behaviour of the Emergency widget. Repainted by the app and the alert check, and every 30 minutes
     (the shortest Android allows) so an expired warning is taken down. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_emergency"
    android:minWidth="180dp"
    android:minHeight="40dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
